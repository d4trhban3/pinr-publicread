# Copy this file to ".env" in the same folder and paste your keys after the = signs.
# ".env" is ignored by git: it never gets committed or published. Never paste keys into chat.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
# Later, when you have an xAI API account (separate from the Grok app / X subscription):
XAI_API_KEY=
# X developer console -> your App -> Keys & Tokens -> App-Only Authentication -> Bearer Token (read-only lookups + XAA)
X_BEARER_TOKEN=
# Anthropic Console (platform.claude.com) -> API keys. For the escalation reviewer (Claude). Separate from a Claude subscription.
ANTHROPIC_API_KEY=
ETHERSCAN_API_KEY=

# --- Free data APIs ---
# Covalent / GoldRush: token holder lists (holder concentration, rug-circle check). Key: goldrush.dev
GOLDRUSH_API_KEY=
# Ankr: backup Base / BNB node. Paste the full endpoint Ankr shows (e.g. https://rpc.ankr.com/base/<long key>);
# one key works for every chain, so any of their endpoints is fine. ankr.com/rpc (free account)
ANKR_ENDPOINT=
# DEX Screener: no key needed (public API, rate-limited). Nothing to fill in.
# More optional providers (names only here, never values):
SHYFT_API_KEY=
DRPC_API_KEY=
CHAINSTACK_SOLANA_URL=
