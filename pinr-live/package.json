{
  "name": "pinr-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-server/server.mjs --log-level=warning",
    "start": "node dist-server/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "feed": "vite-node server/server.ts",
    "contract:check": "vite-node server/check.ts",
    "sample:drop": "node tools/sample-drop.mjs",
    "feed:sample": "node tools/sample-drop.mjs && PINR_DROP_DIR=.sample-drop/frontend-feed PINR_RESULTS_DIRS=.sample-drop/results PINR_MARKET=off PINR_PUMPFUN=off PINR_PUMPPORTAL=off vite-node server/server.ts",
    "control:standin": "node tools/control-standin.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lightweight-charts": "^5.2.1",
    "sharp": "^0.35.5"
  }
}
