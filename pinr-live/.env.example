# Copy this file to .env (same folder) to change where market data comes from. .env is never committed and never sent to the app.
# Everything here is optional: with nothing set, the free sources are used.

# Where current price, 24h change, volume and liquidity come from, in priority order. The first source that knows a token wins.
# Free (no key): dexscreener, jupiter (Solana only), pumpfun (Solana, Pump.fun coins only; slow, last resort). A paid source gets a name here once its provider is added in server/quotes.ts.
# PINR_QUOTE_PROVIDERS=dexscreener,jupiter,pumpfun

# Jupiter: keyless works. With a free key from Jupiter's developer portal, the operator types it on this line in the
# real .env only (it is sent as x-api-key). Its one limit per organisation is shared with the engine, half each: this server's share is
# 15 a minute keyless (one request every 4 s), 30 with the key (every 2 s). PINR_JUPITER_EVERY_MS overrides it.
# JUPITER_API=
# PINR_JUPITER_EVERY_MS=4000

# PumpPortal's free socket: new Pump.fun and bonk.fun coins at creation, and graduations. ONE connection for all of PINR:
# OFF unless switched on, and switched on only in the server's .env. Never on any other copy.
# PINR_PUMPPORTAL=on

# Charts and candles come from GeckoTerminal. Free and public by default (keep to about 5 requests a minute).
# To use a paid plan of the same service, set its address and key, and speed the pace up:
# PINR_GECKO_BASE=https://pro-api.coingecko.com/api/v3/onchain
# PINR_GECKO_KEY=put-the-paid-key-here
# PINR_GECKO_KEY_HEADER=x-cg-pro-api-key
# PINR_GECKO_EVERY_MS=500

# Wallet profile: public blockchain nodes used to read which tracked tokens a wallet holds (read-only). Free public nodes by default;
# put a paid node's address here to swap it in.
# PINR_RPC_BSC=https://bsc-rpc.publicnode.com
# PINR_RPC_BASE=https://base-rpc.publicnode.com
# PINR_RPC_SOLANA=https://api.mainnet-beta.solana.com

# Phone and other-device wallet connection (WalletConnect through Reown). The project id is a PUBLIC identifier for the app, from
# https://dashboard.reown.com (it is built into the page on purpose). In the Reown dashboard add every address PINR is opened from
# (localhost, and your real domain) under allowed domains. Without this line the option is simply not offered.
# VITE_REOWN_PROJECT_ID=put-the-project-id-here

# Feed server port, and a switch to turn market data off completely.
# PINR_FEED_PORT=8787
# PINR_MARKET=off

# Chains served: only the chains the scanner scores now. A comma list; `all` serves every chain. Default: solana.
# PINR_CHAINS=solana
# The operator's free CoinGecko Demo key: read from COINGECKO_API here, else from the engine's own .env (never put the value in this file).
# A viewer's chart reads go through it, up to 300 calls a day (the Demo plan's 10,000 a month); without it the free route answers.
